{
  "id": null,
  "uid": "qlsv-overview",
  "title": "QLSV Application",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "HTTP requests / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "Prometheus"}, "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (method, route)", "legendFormat": "{{method}} {{route}}", "refId": "A"}]},
    {"id": 2, "title": "Response time p95 (seconds)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "Prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"}]},
    {"id": 3, "title": "Student count", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "Prometheus"}, "targets": [{"expr": "qlsv_students_total", "refId": "A"}]},
    {"id": 4, "title": "Database readiness (1 = ready)", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 8}, "datasource": {"type": "prometheus", "uid": "Prometheus"}, "targets": [{"expr": "qlsv_database_ready", "refId": "A"}]}
  ]
}
